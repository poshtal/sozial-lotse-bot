# Скопируй этот файл в .env и заполни значения.
# Файл .env в GitHub не попадает (см. .gitignore): в нём лежат ключи.

# Через сколько минут тишины бот забывает разговор
SESSION_TTL_MINUTES=60

# Токен бота от @BotFather. Если он задан, запускается Telegram-бот.
# Если пусто, бот работает в консоли.
TELEGRAM_BOT_TOKEN=

# Необязательно: INTERFACE=console включает консоль, даже если токен задан
# INTERFACE=console

# --- Понадобится на следующих шагах, пока не используется ---

# Ключ Gemini API и модели
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=

# Адрес Qdrant внутри docker compose
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_DB_COLLECTION_NAME=laws
