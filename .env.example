# Скопируй этот файл в .env и заполни значения.
# Файл .env в GitHub не попадает (см. .gitignore): в нём лежат ключи.

# Через сколько минут тишины бот забывает разговор
SESSION_TTL_MINUTES=60

# Токен бота от @BotFather. Если он задан, запускается Telegram-бот.
# Если пусто, бот работает в консоли.
TELEGRAM_BOT_TOKEN=

# Необязательно: INTERFACE=console включает консоль, даже если токен задан
# INTERFACE=console

# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Модель эмбеддингов. Документы и вопросы обязаны идти через одну и ту же.
# После смены модели базу знаний нужно загрузить заново.
GEMINI_EMBEDDING_MODEL=

# Адрес Qdrant внутри docker compose и имя коллекции
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_DB_COLLECTION_NAME=laws

# Сколько кусков закона поиск возвращает на один вопрос
TOP_K_VALUE=8

# Модель, которая формулирует ответы по найденным кускам закона
GEMINI_GENERATION_MODEL=
# Лёгкая модель для простых шагов (переписать вопрос терминами закона).
# У бесплатного Gemini дневной лимит у каждой модели свой, поэтому лёгкая модель
# снимает с основной половину запросов. Пусто: всё идёт через основную модель.
GEMINI_LIGHT_MODEL=
# Сколько ждать ответа модели, мс. Дольше: бот говорит «не получилось, попробуй позже».
LLM_TIMEOUT_MS=30000
# Пауза перед повтором, если Google перегружен (ошибки 429 и 503), мс.
LLM_RETRY_WAIT_MS=4000

# Ниже этой оценки сходства кусок закона считается неподходящим.
# Если подходящих нет, бот отвечает «этого я пока не умею», модель не вызывается.
# С переписыванием вопроса оценки нужных и ненужных кусков пересекаются
# (0.69–0.81, см. reports/), поэтому порог остаётся страховкой, а неподходящее
# отсеивает модель. Проверяется командой evaluate.
MIN_RELEVANCE_SCORE=0.57
